{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "neuro:guard",
      "materials": { "default": "entity_alphatest" },
      "geometry": { "default": "geometry.vindicator" },
      "textures": { "default": "textures/entity/vindicator" },
      "animations": {
        "walk": "animation.humanoid.walk",
        "look_at_target": "animation.humanoid.look_at_target.default",
        "attack": "animation.humanoid.attack.rotations"
      },
      "scripts": {
        "animate": [
          { "walk": "query.modified_move_speed" },
          "look_at_target",
          { "attack": "variable.attack_time > 0.0" }
        ]
      },
      "render_controllers": ["controller.render.default"]
    }
  }
}
