{
  "format_version": "1.21.60",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:wither_skeleton",
      "spawn_category": "monster",
      "is_spawnable": true,
      "is_summonable": true
    },

    "component_groups": {
      "neuro:alerted": {
        "minecraft:follow_range": { "value": 48, "max": 48 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": false,
          "must_see_forget_duration": 45.0,
          "reselect_targets": true,
          "within_radius": 40,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "max_dist": 40
            }
          ]
        },
        "minecraft:timer": {
          "time": 15,
          "looping": false,
          "time_down_event": { "event": "neuro:calm" }
        }
      },

      "neuro:searching": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 64,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "neuro_waypoint" },
              "max_dist": 64
            }
          ]
        },
        "minecraft:timer": {
          "time": 22,
          "looping": false,
          "time_down_event": { "event": "neuro:stop_search" }
        }
      },

      "neuro:flank": {
        "minecraft:behavior.move_around_target": {
          "priority": 2,
          "destination_position_range": { "min": 3.0, "max": 7.0 }
        },
        "minecraft:timer": {
          "time": 12,
          "looping": false,
          "time_down_event": { "event": "neuro:role_direct" }
        }
      },

      "neuro:siege": {
        "minecraft:behavior.move_around_target": {
          "priority": 2,
          "destination_position_range": { "min": 4.0, "max": 9.0 }
        },
        "minecraft:timer": {
          "time": 15,
          "looping": false,
          "time_down_event": { "event": "neuro:siege_stop" }
        }
      },

      "neuro:ambush": {
        "minecraft:movement": { "value": 0.03 },
        "minecraft:timer": {
          "time": 10,
          "looping": false,
          "time_down_event": { "event": "neuro:ambush_stop" }
        }
      },

      "neuro:retreat": {
        "minecraft:behavior.avoid_mob_type": {
          "priority": 1,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "max_dist": 12.0,
              "walk_speed_multiplier": 1.3,
              "sprint_speed_multiplier": 1.4
            }
          ]
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 64,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "neuro_waypoint" },
              "max_dist": 64
            }
          ]
        },
        "minecraft:timer": {
          "time": 12,
          "looping": false,
          "time_down_event": { "event": "neuro:retreat_stop" }
        }
      },

      "neuro:veteran": {
        "minecraft:knockback_resistance": { "value": 0.6 }
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["wither_skeleton", "skeleton", "undead", "monster", "mob", "neuro_smart"] },
      "minecraft:nameable": {},
      "minecraft:collision_box": { "width": 0.7, "height": 2.4 },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:attack": { "damage": 4, "effect_name": "wither", "effect_duration": 10 },
      "minecraft:movement": { "value": 0.25 },
      "minecraft:follow_range": { "value": 40, "max": 40 },
      "minecraft:fire_immune": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0, "breathes_air": true, "breathes_water": false },
      "minecraft:loot": { "table": "loot_tables/entities/wither_skeleton.json" },
      "minecraft:equipment": { "table": "loot_tables/entities/neuro_wither_skeleton_gear.json" },
      "minecraft:experience_reward": { "on_death": "query.last_hit_by_player ? 5 : 0" },
      "minecraft:despawn": { "despawn_from_distance": {} },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},

      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "avoid_damage_blocks": false
      },
      "minecraft:preferred_path": {
        "max_fall_blocks": 3,
        "jump_cost": 5,
        "default_block_cost": 1.5
      },

      "minecraft:on_target_acquired": { "event": "neuro:on_target_acquired", "target": "self" },
      "minecraft:on_target_escape": { "event": "neuro:on_target_escape", "target": "self" },

      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },

      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "must_see_forget_duration": 12.0,
        "reselect_targets": true,
        "within_radius": 24,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                { "test": "is_family", "subject": "other", "value": "player" },
                { "test": "has_tag", "subject": "other", "value": "neuro_prio" }
              ]
            },
            "max_dist": 28
          },
          {
            "filters": { "test": "is_family", "subject": "other", "value": "player" },
            "max_dist": 24
          },
          {
            "filters": { "test": "is_family", "subject": "other", "value": "irongolem" },
            "max_dist": 20
          }
        ]
      },

      "minecraft:behavior.melee_box_attack": { "priority": 3, "track_target": true },
      "minecraft:behavior.random_stroll": { "priority": 7, "speed_multiplier": 1.0 },
      "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 8.0 },
      "minecraft:behavior.random_look_around": { "priority": 9 }
    },

    "events": {
      "minecraft:entity_spawned": {},

      "neuro:on_target_acquired": { "remove": { "component_groups": ["neuro:searching"] } },
      "neuro:on_target_escape": {},

      "neuro:alert": {
        "remove": { "component_groups": ["neuro:searching"] },
        "add": { "component_groups": ["neuro:alerted"] }
      },
      "neuro:calm": { "remove": { "component_groups": ["neuro:alerted"] } },

      "neuro:start_search": { "add": { "component_groups": ["neuro:searching"] } },
      "neuro:stop_search": { "remove": { "component_groups": ["neuro:searching"] } },

      "neuro:role_flank": { "add": { "component_groups": ["neuro:flank"] } },
      "neuro:role_direct": { "remove": { "component_groups": ["neuro:flank"] } },

      "neuro:siege_start": {
        "remove": { "component_groups": ["neuro:flank"] },
        "add": { "component_groups": ["neuro:siege"] }
      },
      "neuro:siege_stop": { "remove": { "component_groups": ["neuro:siege"] } },

      "neuro:ambush_start": {
        "remove": { "component_groups": ["neuro:flank"] },
        "add": { "component_groups": ["neuro:ambush"] }
      },
      "neuro:ambush_stop": { "remove": { "component_groups": ["neuro:ambush"] } },

      "neuro:retreat_start": {
        "remove": { "component_groups": ["neuro:flank", "neuro:siege", "neuro:ambush"] },
        "add": { "component_groups": ["neuro:retreat"] }
      },
      "neuro:retreat_stop": { "remove": { "component_groups": ["neuro:retreat"] } },

      "neuro:make_veteran": { "add": { "component_groups": ["neuro:veteran"] } }
    }
  }
}
