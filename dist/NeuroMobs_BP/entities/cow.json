{
  "format_version": "1.21.60",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:cow",
      "spawn_category": "creature",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "minecraft:cow_baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            "wheat"
          ],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 5,
          "speed_multiplier": 1.1
        },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 3,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "monster"
              },
              "max_dist": 12.0,
              "walk_speed_multiplier": 1.2,
              "sprint_speed_multiplier": 1.4
            }
          ]
        }
      },
      "minecraft:cow_adult": {
        "minecraft:experience_reward": {
          "on_bred": "Math.Random(1,7)",
          "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
        },
        "minecraft:breedable": {
          "require_tame": false,
          "breed_items": [
            "wheat"
          ],
          "breeds_with": [
            {
              "mate_type": "minecraft:cow",
              "baby_type": "minecraft:cow",
              "breed_event": {
                "event": "minecraft:entity_born",
                "target": "baby"
              }
            }
          ]
        },
        "minecraft:behavior.breed": {
          "priority": 2,
          "speed_multiplier": 1.0
        },
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    {
                      "test": "is_family",
                      "subject": "other",
                      "value": "player"
                    },
                    {
                      "test": "has_equipment",
                      "subject": "other",
                      "domain": "hand",
                      "value": "bucket"
                    }
                  ]
                }
              },
              "use_item": true,
              "transform_to_item": "milk_bucket",
              "play_sounds": "milk"
            }
          ]
        }
      },
      "neuro:wary": {
        "minecraft:behavior.avoid_mob_type": {
          "priority": 3,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "monster"
              },
              "max_dist": 8.0,
              "walk_speed_multiplier": 1.1,
              "sprint_speed_multiplier": 1.2
            },
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 10.0,
              "walk_speed_multiplier": 1.15,
              "sprint_speed_multiplier": 1.3
            }
          ]
        },
        "minecraft:timer": {
          "time": 20,
          "looping": false,
          "time_down_event": {
            "event": "neuro:wary_off"
          }
        }
      },
      "neuro:resting": {
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.4,
          "interval": 240
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "cow",
          "mob"
        ]
      },
      "minecraft:nameable": {},
      "minecraft:collision_box": {
        "width": 0.9,
        "height": 1.3
      },
      "minecraft:health": {
        "value": 10,
        "max": 10
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": false
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/cow.json"
      },
      "minecraft:leashable": {
        "soft_distance": 4.0,
        "hard_distance": 6.0,
        "max_distance": 10.0
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "avoid_damage_blocks": true,
        "avoid_water": true
      },
      "minecraft:preferred_path": {
        "max_fall_blocks": 2,
        "jump_cost": 5,
        "default_block_cost": 1.5,
        "preferred_path_blocks": [
          {
            "cost": 50,
            "blocks": [
              "magma",
              "cactus",
              "sweet_berry_bush",
              "campfire",
              "soul_campfire",
              "wither_rose"
            ]
          }
        ]
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.25
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 3,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "monster"
            },
            "max_dist": 8.0,
            "walk_speed_multiplier": 1.1,
            "sprint_speed_multiplier": 1.2
          }
        ]
      },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1.2,
        "items": [
          "wheat"
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6.0
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "test": "hourly_clock_time",
              "operator": ">=",
              "value": 12000
            },
            "event": "neuro:rest"
          },
          {
            "filters": {
              "test": "hourly_clock_time",
              "operator": "<",
              "value": 12000
            },
            "event": "neuro:wake"
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "randomize": [
          {
            "weight": 90,
            "add": {
              "component_groups": [
                "minecraft:cow_adult"
              ]
            }
          },
          {
            "weight": 10,
            "add": {
              "component_groups": [
                "minecraft:cow_baby"
              ]
            }
          }
        ]
      },
      "minecraft:entity_born": {
        "add": {
          "component_groups": [
            "minecraft:cow_baby"
          ]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "minecraft:cow_baby"
          ]
        },
        "add": {
          "component_groups": [
            "minecraft:cow_adult"
          ]
        }
      },
      "neuro:wary_on": {
        "add": {
          "component_groups": [
            "neuro:wary"
          ]
        }
      },
      "neuro:wary_off": {
        "remove": {
          "component_groups": [
            "neuro:wary"
          ]
        }
      },
      "neuro:rest": {
        "add": {
          "component_groups": [
            "neuro:resting"
          ]
        }
      },
      "neuro:wake": {
        "remove": {
          "component_groups": [
            "neuro:resting"
          ]
        }
      }
    }
  }
}