{
  "format_version": "1.21.60",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:creeper",
      "spawn_category": "monster",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "minecraft:exploding": {
        "minecraft:explode": {
          "fuse_length": 1.5,
          "fuse_lit": true,
          "power": 3,
          "causes_fire": false,
          "destroy_affected_by_griefing": true
        }
      },
      "minecraft:charged_creeper": {
        "minecraft:is_charged": {}
      },
      "minecraft:charged_exploding": {
        "minecraft:is_charged": {},
        "minecraft:explode": {
          "fuse_length": 1.5,
          "fuse_lit": true,
          "power": 6,
          "causes_fire": false,
          "destroy_affected_by_griefing": true
        }
      },
      "minecraft:forced_exploding": {
        "minecraft:explode": {
          "fuse_length": 1.5,
          "fuse_lit": true,
          "power": 3,
          "causes_fire": false,
          "destroy_affected_by_griefing": true
        },
        "minecraft:target_nearby_sensor": {}
      },
      "neuro:stalking": {
        "minecraft:movement": {
          "value": 0.05
        },
        "minecraft:timer": {
          "time": 8,
          "looping": false,
          "time_down_event": {
            "event": "neuro:unfreeze"
          }
        }
      },
      "neuro:alerted": {
        "minecraft:follow_range": {
          "value": 48,
          "max": 48
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": false,
          "must_see_forget_duration": 45.0,
          "reselect_targets": true,
          "within_radius": 40,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 40
            }
          ]
        },
        "minecraft:timer": {
          "time": 15,
          "looping": false,
          "time_down_event": {
            "event": "neuro:calm"
          }
        }
      },
      "neuro:searching": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 64,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "neuro_waypoint"
              },
              "max_dist": 64
            }
          ]
        },
        "minecraft:timer": {
          "time": 22,
          "looping": false,
          "time_down_event": {
            "event": "neuro:stop_search"
          }
        }
      },
      "neuro:veteran": {
        "minecraft:knockback_resistance": {
          "value": 0.6
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "creeper",
          "monster",
          "mob",
          "neuro_smart"
        ]
      },
      "minecraft:nameable": {},
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.8
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:attack": {
        "damage": 3
      },
      "minecraft:movement": {
        "value": 0.2
      },
      "minecraft:follow_range": {
        "value": 32,
        "max": 32
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": false
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/creeper.json"
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 5 : 0"
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "avoid_damage_blocks": true
      },
      "minecraft:preferred_path": {
        "max_fall_blocks": 3,
        "jump_cost": 5,
        "default_block_cost": 1.5,
        "preferred_path_blocks": [
          {
            "cost": 50,
            "blocks": [
              "magma",
              "cactus",
              "sweet_berry_bush",
              "campfire",
              "soul_campfire",
              "wither_rose"
            ]
          }
        ]
      },
      "minecraft:target_nearby_sensor": {
        "inside_range": 2.5,
        "outside_range": 6.0,
        "must_see": true,
        "on_inside_range": {
          "event": "minecraft:start_exploding",
          "target": "self"
        },
        "on_outside_range": {
          "event": "minecraft:stop_exploding",
          "target": "self"
        },
        "on_vision_lost_inside_range": {
          "event": "minecraft:stop_exploding",
          "target": "self"
        }
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_equipment",
                    "subject": "other",
                    "domain": "hand",
                    "value": "flint_and_steel"
                  }
                ]
              },
              "event": "minecraft:start_exploding_forced",
              "target": "self"
            },
            "hurt_item": 1,
            "swing": true,
            "play_sounds": "ignite"
          }
        ]
      },
      "minecraft:on_target_acquired": {
        "event": "neuro:on_target_acquired",
        "target": "self"
      },
      "minecraft:on_target_escape": {
        "event": "neuro:on_target_escape",
        "target": "self"
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "must_see": true,
        "must_see_forget_duration": 12.0,
        "reselect_targets": true,
        "within_radius": 24,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "value": "neuro_prio"
                }
              ]
            },
            "max_dist": 28
          },
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 24
          }
        ]
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 2
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 3,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "cat"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "ocelot"
                }
              ]
            },
            "max_dist": 6.0,
            "walk_speed_multiplier": 1.2,
            "sprint_speed_multiplier": 1.3
          }
        ]
      },
      "minecraft:behavior.swell": {
        "priority": 4,
        "start_distance": 2.5,
        "stop_distance": 6.0
      },
      "minecraft:behavior.melee_box_attack": {
        "priority": 5,
        "track_target": true,
        "horizontal_reach": 0.0
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8.0
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      }
    },
    "events": {
      "minecraft:entity_spawned": {},
      "minecraft:start_exploding": {
        "sequence": [
          {
            "filters": {
              "test": "has_component",
              "operator": "!=",
              "value": "minecraft:is_charged"
            },
            "add": {
              "component_groups": [
                "minecraft:exploding"
              ]
            }
          },
          {
            "filters": {
              "test": "has_component",
              "value": "minecraft:is_charged"
            },
            "add": {
              "component_groups": [
                "minecraft:charged_exploding"
              ]
            }
          }
        ]
      },
      "minecraft:stop_exploding": {
        "remove": {
          "component_groups": [
            "minecraft:exploding",
            "minecraft:charged_exploding"
          ]
        }
      },
      "minecraft:start_exploding_forced": {
        "remove": {
          "component_groups": [
            "neuro:stalking"
          ]
        },
        "add": {
          "component_groups": [
            "minecraft:forced_exploding"
          ]
        }
      },
      "minecraft:become_charged": {
        "remove": {
          "component_groups": [
            "minecraft:exploding"
          ]
        },
        "add": {
          "component_groups": [
            "minecraft:charged_creeper"
          ]
        }
      },
      "neuro:on_target_acquired": {
        "remove": {
          "component_groups": [
            "neuro:searching"
          ]
        }
      },
      "neuro:on_target_escape": {
        "remove": {
          "component_groups": [
            "neuro:stalking"
          ]
        }
      },
      "neuro:freeze": {
        "add": {
          "component_groups": [
            "neuro:stalking"
          ]
        }
      },
      "neuro:unfreeze": {
        "remove": {
          "component_groups": [
            "neuro:stalking"
          ]
        }
      },
      "neuro:alert": {
        "remove": {
          "component_groups": [
            "neuro:searching"
          ]
        },
        "add": {
          "component_groups": [
            "neuro:alerted"
          ]
        }
      },
      "neuro:calm": {
        "remove": {
          "component_groups": [
            "neuro:alerted"
          ]
        }
      },
      "neuro:start_search": {
        "add": {
          "component_groups": [
            "neuro:searching"
          ]
        }
      },
      "neuro:stop_search": {
        "remove": {
          "component_groups": [
            "neuro:searching"
          ]
        }
      },
      "neuro:make_veteran": {
        "add": {
          "component_groups": [
            "neuro:veteran"
          ]
        }
      }
    }
  }
}