{
  "format_version": "1.21.60",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:enderman",
      "spawn_category": "monster",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "neuro:searching": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 3,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 64,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "neuro_waypoint"
              },
              "max_dist": 64
            }
          ]
        },
        "minecraft:timer": {
          "time": 22,
          "looping": false,
          "time_down_event": {
            "event": "neuro:stop_search"
          }
        }
      },
      "neuro:veteran": {
        "minecraft:knockback_resistance": {
          "value": 0.6
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "enderman",
          "monster",
          "mob",
          "neuro_smart"
        ]
      },
      "minecraft:nameable": {},
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 2.9
      },
      "minecraft:health": {
        "value": 40,
        "max": 40
      },
      "minecraft:attack": {
        "damage": 7
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:follow_range": {
        "value": 64,
        "max": 64
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": false
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava"
            },
            "cause": "lava",
            "damage_per_tick": 4
          },
          {
            "filters": {
              "test": "in_water_or_rain",
              "value": true
            },
            "cause": "drowning",
            "damage_per_tick": 1
          }
        ]
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/enderman.json"
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 5 : 0"
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_walk": true,
        "can_pass_doors": true,
        "avoid_damage_blocks": true,
        "avoid_water": true
      },
      "minecraft:preferred_path": {
        "max_fall_blocks": 3,
        "jump_cost": 5,
        "default_block_cost": 1.5,
        "preferred_path_blocks": [
          {
            "cost": 50,
            "blocks": [
              "magma",
              "cactus",
              "sweet_berry_bush",
              "campfire",
              "soul_campfire",
              "wither_rose"
            ]
          }
        ]
      },
      "minecraft:teleport": {
        "random_teleports": true,
        "max_random_teleport_time": 30,
        "random_teleport_cube": [
          32,
          16,
          32
        ],
        "target_distance": 16,
        "target_teleport_chance": 0.05,
        "light_teleport_chance": 0.05,
        "dark_teleport_chance": 0.2
      },
      "minecraft:lookat": {
        "search_radius": 48.0,
        "set_target": true,
        "look_cooldown": 5.0,
        "filters": {
          "all_of": [
            {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            {
              "test": "has_equipment",
              "subject": "other",
              "domain": "head",
              "operator": "not",
              "value": "carved_pumpkin"
            }
          ]
        }
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "projectile",
            "deals_damage": false
          }
        ]
      },
      "minecraft:on_target_acquired": {
        "event": "neuro:on_target_acquired",
        "target": "self"
      },
      "minecraft:on_target_escape": {
        "event": "neuro:on_target_escape",
        "target": "self"
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.melee_box_attack": {
        "priority": 4,
        "track_target": true
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8.0
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      }
    },
    "events": {
      "minecraft:entity_spawned": {},
      "neuro:on_target_acquired": {
        "remove": {
          "component_groups": [
            "neuro:searching"
          ]
        }
      },
      "neuro:on_target_escape": {},
      "neuro:start_search": {
        "add": {
          "component_groups": [
            "neuro:searching"
          ]
        }
      },
      "neuro:stop_search": {
        "remove": {
          "component_groups": [
            "neuro:searching"
          ]
        }
      },
      "neuro:make_veteran": {
        "add": {
          "component_groups": [
            "neuro:veteran"
          ]
        }
      }
    }
  }
}